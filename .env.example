# CariCue environment variables.
#
#   cp .env.example .env
#
# Every value here has a safe default for local development except
# DJANGO_SECRET_KEY, which must be set for any non-DEBUG run. Do not commit
# a real .env.

# --------------------------------------------------------------------------- #
# Django core
# --------------------------------------------------------------------------- #
# 1 enables Django's debug mode. Never enable it on a public deployment.
DJANGO_DEBUG=0

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-before-deploying

# Hostnames Django will answer to, comma separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to send unsafe requests, comma separated. Required in
# production and whenever the SPA and API are on different ports (e.g. Vite on
# :5173 proxying to Django on :8000). In DEBUG mode the Vite origins are added
# automatically; set this explicitly for non-DEBUG or custom dev setups.
# Production example: https://caricue.example.edu
# Local dev (if DEBUG=0): http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- #
# Public address
# --------------------------------------------------------------------------- #
# Absolute base URL students reach the app on. QR codes and join links are
# built from this, so it must be resolvable from a phone on the classroom
# network — not "localhost" unless you are testing on the same machine.
PUBLIC_BASE_URL=http://localhost:8080

# --------------------------------------------------------------------------- #
# Google OAuth (teachers and students)
# --------------------------------------------------------------------------- #
# Create a Google Cloud OAuth 2.0 Web client and set authorized redirect URIs to:
#   http://localhost:8080/api/auth/google/callback/
# (or your PUBLIC_BASE_URL + /api/auth/google/callback/ in production).
# Leave blank to disable Google sign-in (email/password teachers still work).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; defaults to PUBLIC_BASE_URL + /api/auth/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=
# Comma-separated school domains, e.g. yourschool.edu. Empty allows any domain.
OAUTH_ALLOWED_EMAIL_DOMAINS=

# Host port Nginx publishes in the production compose file.
HTTP_PORT=8080

# --------------------------------------------------------------------------- #
# Database
# --------------------------------------------------------------------------- #
# `postgres` (supported) or `sqlite` (test-only escape hatch).
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=caricue
POSTGRES_USER=caricue
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --------------------------------------------------------------------------- #
# Cookies and transport security
# --------------------------------------------------------------------------- #
# Defaults to the opposite of DJANGO_DEBUG. Keep secure cookies on whenever
# the app is served over HTTPS.
DJANGO_SECURE_COOKIES=1
DJANGO_TRUST_PROXY_SSL_HEADER=1
DJANGO_USE_X_FORWARDED_HOST=1
# Leave this to the TLS-terminating proxy unless Django itself is exposed.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_AGE=43200

# --------------------------------------------------------------------------- #
# Container start-up behaviour
# --------------------------------------------------------------------------- #
DJANGO_MIGRATE_ON_START=1
DJANGO_COLLECTSTATIC_ON_START=1
# 1 creates the demonstration teacher, class, activity and sessions. Leave at
# 0 for anything resembling production.
CARICUE_SEED_DEMO=0

# --------------------------------------------------------------------------- #
# Public endpoint throttles (DRF rate strings)
# --------------------------------------------------------------------------- #
THROTTLE_PUBLIC_LOOKUP=30/min
THROTTLE_PUBLIC_JOIN=20/min
THROTTLE_PUBLIC_SUBMIT=20/min
THROTTLE_AUTH_ATTEMPT=10/min

# --------------------------------------------------------------------------- #
# Product limits and insight thresholds
# --------------------------------------------------------------------------- #
CARICUE_MIN_QUESTIONS=1
CARICUE_MAX_QUESTIONS=5
CARICUE_MAX_CHOICES=6
CARICUE_SHORT_CODE_LENGTH=6
CARICUE_DASHBOARD_POLL_SECONDS=4
CARICUE_HIGH_CONFIDENCE_THRESHOLD=4
CARICUE_LOW_CONFIDENCE_THRESHOLD=2
CARICUE_ATTENTION_SCORE_THRESHOLD=50
CARICUE_LOW_CORRECTNESS_THRESHOLD=60
CARICUE_COMMON_ANSWER_LIMIT=5

# --------------------------------------------------------------------------- #
# Optional AI suggestions
# --------------------------------------------------------------------------- #
# The rule-based provider is deterministic, needs no key, and never sends
# student text anywhere. Swap it for
# caricue.insights.providers.LLMInsightProvider only if you have reviewed the
# privacy implications; prompts exclude names and identifiers either way.
CARICUE_INSIGHT_PROVIDER=caricue.insights.providers.RuleBasedInsightProvider
CARICUE_LLM_API_KEY=
CARICUE_LLM_MODEL=mock-llm-v1
